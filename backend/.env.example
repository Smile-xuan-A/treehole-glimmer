# ==================== 数据库配置 ====================
DB_HOST=localhost
DB_PORT=3306
DB_USER=root
DB_PASSWORD=your_password
DB_NAME=whisper_hole

# ==================== 安全配置 ====================
IP_SALT=whisper-hole-secret-salt-change-in-production
PORT=3000

# ==================== 内容审核（可选）====================
# 百度智能云内容安全（如不配置则使用本地关键词过滤）
BAIDU_API_KEY=
BAIDU_SECRET_KEY=

# ==================== 运行环境 ====================
NODE_ENV=development
